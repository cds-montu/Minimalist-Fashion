# Google OAuth Configuration
# Create a project at https://console.cloud.google.com/
# Enable Google+ API and create OAuth 2.0 credentials
# Add http://localhost:3000 to Authorized JavaScript origins and Authorized redirect URIs
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id-here

# API Configuration
REACT_APP_API_BASE_URL=http://localhost:5000/api

# Admin UI access code. Required to reach /admin. Anything in a REACT_APP_*
# variable is embedded in the JS bundle and therefore public, so this only hides
# the admin UI -- admin APIs must still be authorized server-side.
REACT_APP_ADMIN_ACCESS_CODE=

# Environment
NODE_ENV=development
